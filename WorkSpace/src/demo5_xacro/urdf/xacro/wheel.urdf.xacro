<robot name="wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 驱动轮 -->
    <xacro:property name="driving_wheel_radius" value="0.0325" />
    <xacro:property name="driving_wheel_length" value="0.015" />
    <xacro:property name="joint_rpy" value="${PI/2}" />
    <xacro:property name="joint_axis" value="1.0" />
    <xacro:property name="joint_x" value="${base_radius + driving_wheel_length/2}" />
    <xacro:property name="joint_z" value="${driving_wheel_radius - base_z}" />

    <!-- 驱动轮宏定义 --> 
    <xacro:macro name="driving_wheel" params="id flag">
        <link name="driving_wheel_link_${id}">
            <visual name="wheel_${id}">
                <geometry>
                    <cylinder radius="${driving_wheel_radius}" length="${driving_wheel_length}"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <material name="blue">
                    <color rgba="0.37 0.5 0.25 1.0"/>
                </material>
            </visual>

            <!-- <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.0 0.0 0.0"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="0.0"/>
                <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
            </inertial> -->
        </link>
        
        <joint name="driving_base_${id}" type="continuous">
            <origin xyz="${joint_x * flag} 0.0 ${joint_z}" rpy="0.0 ${joint_rpy} 0.0"/>
            <parent link="base_link"/>
            <child link="driving_wheel_link_${id}"/>
            <axis xyz="0.0 0.0 ${joint_axis}"/>
        </joint>

    </xacro:macro>

    <!-- 驱动轮宏调用 -->
    <xacro:driving_wheel id="left" flag="1" />
    <xacro:driving_wheel id="right" flag="-1" />


    <!-- 万向轮 -->
    <xacro:property name="universal_wheel_radius" value="0.0075" />
    <xacro:property name="universal_joint_y" value="${base_radius - universal_wheel_radius}" />
    <xacro:property name="universal_joint_z" value="${universal_wheel_radius - base_z}" />

    <!-- 万向论宏定义 -->
    <xacro:macro name="universal" params="id flag">
        <link name="universal_wheel_link_${id}">
            <visual name="universal_${id}">
                <geometry>
                    <sphere radius="${universal_wheel_radius}"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <material name="blue">
                    <color rgba="0.7 0.5 0.2 1.0"/>
                </material>
            </visual>
        </link>

        <joint name="universal_base_${id}" type="continuous">
            <origin xyz="0.0 ${universal_joint_y * flag} ${universal_joint_z}" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="universal_wheel_link_${id}"/>
            <axis xyz="${joint_axis} ${joint_axis} ${joint_axis}"/>
        </joint>

    </xacro:macro>

    <!-- 万向轮调用 -->
    <xacro:universal id="front" flag="1" />
    <xacro:universal id="back" flag="-1" />

</robot>