<launch>

    <!-- 将 Urdf 文件的内容加载到参数服务器 -->
    <param name="robot_description" textfile="$(find demo5_xacro)/urdf/urdf/demo01.urdf" />

    <!-- 启动 gazebo 仿真环境 -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch" />

    <!-- 在 gazebo 中显示机器人模型，相当于rosrun gazebo_ros spawn_model -urdf -model mycar -param robot_description --> 
    <node pkg="gazebo_ros" type="spawn_model" name="model" args="-urdf -model mycar -param robot_description"  />
</launch>