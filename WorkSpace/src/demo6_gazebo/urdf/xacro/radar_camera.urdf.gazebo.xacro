<robot name="radar_camera" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 雷达和杆子 -->
    <xacro:property name="height" value="0.2" />
    <xacro:property name="radius" value="0.02"/>
    <xacro:property name="radar_h_w" value="0.05" />
    <xacro:property name="radar_mass" value="0.01" />
    <xacro:property name="pole_mass" value="0.1" />
    <xacro:property name="pole_z" value="${height/2 + base_length/2}" />
    <xacro:property name="radar_z" value="${radar_h_w/2 + height/2}" />

    <link name="radarlink">
        <visual name="radar">
            <geometry>
                <box size="${radar_h_w} ${radar_h_w} ${radar_h_w}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="${radar_h_w} ${radar_h_w} ${radar_h_w}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </collision>

        <xacro:Box_inertial_matrix m="${radar_mass}" l="${radar_h_w}" w="${radar_h_w}" h="${radar_h_w}" />
    </link>

    <gazebo reference="radarlink">
        <material>Gazebo/Black</material>
    </gazebo>


    <link name="polelink">
        <visual name="pole">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="${radius}" length="${height}" />
            </geometry>
            <material name="yellow">
                <color rgba="0.18 0.58 0.26 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="${radius}" length="${height}" />
            </geometry>
        </collision>

        <xacro:cylinder_inertial_matrix m="${pole_mass}" r="${radius}" h="${height}" />
    </link>

    <gazebo reference="polelink">
        <material>Gazebo/Grey</material>
    </gazebo>

    <joint name="radar_pole" type="continuous">
        <parent link="polelink"/>
        <child link="radarlink"/>
        <origin xyz="0.0 0.0 ${radar_z}" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 0.0 1.0"/>
    </joint>

    <joint name="pole_base" type="fixed">
        <parent link="base_link"/>
        <child link="polelink"/>
        <origin xyz="0.0 0.0 ${pole_z}" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 0.0 0.0"/>
    </joint>

    <!-- 相机 -->
    <xacro:property name="x" value="0.02" />
    <xacro:property name="y" value="0.03" />
    <xacro:property name="z" value="0.04" />
    <xacro:property name="camera_mass" value="0.02" />
    <xacro:property name="camera_z" value="${base_length/2+ z/2}" />
    <xacro:property name="camera_y" value="${base_radius - y/2}" />


    <link name="cameralink">
        <visual name="camera">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${x} ${y} ${z}"/>
            </geometry>
            <material name="blue">
                <color rgba="1.0 0.0 0.5 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${x} ${y} ${z}"/>
            </geometry>
        </collision>

        <xacro:Box_inertial_matrix m="${camera_mass}" l="${x}" w="${y}" h="${z}" />
    </link>

    <gazebo reference="cameralink">
        <material>Gazebo/Blue</material>
    </gazebo>

    <joint name="camera_base" type="fixed">
        <origin xyz="0.0 ${camera_y} ${camera_z}" rpy="0.0 0.0 ${joint_rpy}"/>
        <parent link="base_link"/>
        <child link="cameralink"/>
        <axis xyz="0.0 0.0 0.0"/>
    </joint>

</robot>