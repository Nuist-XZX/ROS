<launch>
    <node pkg="turtlesim" type="turtlesim_node" name="turtle_window" output="screen"/>
    <node pkg="turtlesim" type="turtle_teleop_key" name="turtle_key" output="screen"/>
    <node pkg="dynamic_coor_tf" type="dynamic_pub" name="dynamic_tf_pub" output="screen"/>
    <node pkg="dynamic_coor_tf" type="dynamic_sub" name="dynamic_tf_sub" output="screen"/>
</launch>