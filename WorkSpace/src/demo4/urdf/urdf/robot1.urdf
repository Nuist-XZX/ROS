<robot name="robot1">
    <link name="base_link">
        <visual>

            <!-- 添加底盘 -->
            <geometry>
                <cylinder radius="0.1" length="0.08"/>
            </geometry>

            <origin xyz="0 0 0" rpy="0 0 0" />

            <material name="black">
                <color rgba="0.7 0.5 0 0.5" />
            </material>

        </visual>
    </link>

    <!-- 添加驱动轮 -->
    <link name="Driving_wheel_01">
        <visual>
    
            <geometry>
                <cylinder radius="0.0325" length="0.015" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
            <material name="red">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>

        </visual>
    </link>

    <link name="Driving_wheel_02">
        <visual>
    
            <geometry>
                <cylinder radius="0.0325" length="0.015" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
            <material name="red">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>

        </visual>
    </link>

    <!-- 添加万向论 -->
    <link name="Universal_wheel_01">
        <visual>
            <geometry>
                <sphere radius="0.0075"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
            
        </visual>
    </link>

        <link name="Universal_wheel_02">
        <visual>
            <geometry>
                <sphere radius="0.0075"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
            
        </visual>
    </link>

    <joint name="wheel_01" type="continuous">
        <parent link="base_link"/>
        <child link="Driving_wheel_01"/>
        <origin xyz="0.0 -0.1075 -0.0225" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>


    <joint name="wheel_02" type="continuous">
        <parent link="base_link"/>
        <child link="Driving_wheel_02"/>
        <origin xyz="0.0 0.1075 -0.0225" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

    <joint name="wheel_03" type="continuous">
        <parent link="base_link"/>
        <child link="Universal_wheel_01"/>
        <origin xyz="0.0925 0.0 -0.0475" rpy="0.0 0.0 0.0"/>
        <axis xyz="1.0 1.0 1.0"/>
    </joint>

    <joint name="wheel_04" type="continuous">
        <parent link="base_link"/>
        <child link="Universal_wheel_02"/>
        <origin xyz="-0.0925 0.0 -0.0475" rpy="0.0 0.0 0.0"/>
        <axis xyz="1.0 1.0 1.0"/>
    </joint>
    
</robot>