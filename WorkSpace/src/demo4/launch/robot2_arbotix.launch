<launch>

    <param name="robot_description" textfile="$(find demo4)/urdf/urdf/robot2.urdf" />
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find demo4)/config/show_mycar.rviz" /> 

    <!-- 添加关节状态发布节点 -->
    <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher" />
    <!-- 添加机器人状态发布节点 -->
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />
    <!-- 可选:用于控制关节运动的节点 -->
    <node pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" name="joint_state_publisher_gui" />
    <!-- 集成arbotix运动控制节点，并加载参数 -->
    <node pkg="arbotix_python" type="arbotix_driver" name="arbotix_driver" output="screen" >
        <!-- 加载参数，位于.yaml文件中，在config文件夹下 -->
        <rosparam command="load" file="$(find demo4)/config/robot2_arbotix_config.yaml" />
        <!-- 设置仿真环境 -->
        <param name="sim" value="true" />  
    </node>

</launch>