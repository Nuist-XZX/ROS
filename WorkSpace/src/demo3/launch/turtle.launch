<launch>
    <!-- 启动乌龟节点和键盘控制节点 -->
    <node pkg="turtlesim" type="turtlesim_node" name="turtle1" output="screen"/>
    <node pkg="turtlesim" type="turtle_teleop_key" name="key_control" output="screen"/>
    <!-- 启动创建第二只乌龟节点 -->
    <node pkg="demo3" type="turtle_client" name="turtle2" output="screen"/>
    <!-- 启动两个坐标发布节点 -->
    <node pkg="demo3" type="turtle_pub" name="turtle_pub_1" args="turtle1" output="screen"/>
    <node pkg="demo3" type="turtle_pub" name="turtle_pub_2" args="turtle2" output="screen"/>
    <!-- 启动坐标转换和运动节点 -->
    <node pkg="demo3" type="turtle_sub" name="turtle_sub" output="screen"/>
</launch>